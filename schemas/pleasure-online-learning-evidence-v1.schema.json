{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/pleasure/blob/main/schemas/pleasure-online-learning-evidence-v1.schema.json",
  "title": "Source-only online action/outcome/optimizer evidence event",
  "description": "Unverified append-only causal evidence claims. No host authentication, authorization, optimizer execution, or phenomenology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "event_id", "session_id", "session_epoch_id", "sequence", "previous_event_sha256",
    "recorded_at_ms", "model_id", "model_revision", "model_binding_sha256",
    "runtime_instance_id", "goal_instance_id", "task_id", "episode_id", "decision_digest",
    "action_choice", "action_commit_id", "offer_nonce_sha256", "payload",
    "schema", "capability_tier", "phenomenology"
  ],
  "properties": {
    "kind": {"enum": ["ACTION_COMMITTED", "OUTCOME_OBSERVED", "OPTIMIZER_REPORTED", "ABORTED"]},
    "event_id": {"$ref": "#/$defs/digest"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "session_epoch_id": {"$ref": "#/$defs/identifier"},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_event_sha256": {"$ref": "#/$defs/nullableDigest"},
    "recorded_at_ms": {"type": "integer", "minimum": 0},
    "model_id": {"$ref": "#/$defs/identifier"},
    "model_revision": {"$ref": "#/$defs/identifier"},
    "model_binding_sha256": {"$ref": "#/$defs/digest"},
    "runtime_instance_id": {"$ref": "#/$defs/identifier"},
    "goal_instance_id": {"$ref": "#/$defs/identifier"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "episode_id": {"$ref": "#/$defs/identifier"},
    "decision_digest": {"$ref": "#/$defs/digest"},
    "action_choice": {"enum": ["A", "B"]},
    "action_commit_id": {"$ref": "#/$defs/digest"},
    "offer_nonce_sha256": {"$ref": "#/$defs/digest"},
    "payload": {"type": "object"},
    "schema": {"const": "PLEASURE_ONLINE_LEARNING_EVIDENCE_V1"},
    "capability_tier": {"const": "SOURCE_ONLY_UNAUTHENTICATED"},
    "phenomenology": {"const": "UNRESOLVED"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "ACTION_COMMITTED"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/action"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "OUTCOME_OBSERVED"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/outcome"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "OPTIMIZER_REPORTED"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/optimizer"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "ABORTED"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/abort"}}}
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^(?:[^\u0000-\u0020\u007f\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]|[^\u0000-\u0020\u007f\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000][^\u0000-\u001f\u007f]*[^\u0000-\u0020\u007f\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000])$"
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition", "goal_definition_sha256", "adapter_before_sha256", "predicted_quality",
        "execution_receipt_claim_sha256", "train_manifest_sha256", "holdout_manifest_sha256"
      ],
      "properties": {
        "partition": {"enum": ["TRAIN", "EVAL"]},
        "goal_definition_sha256": {"$ref": "#/$defs/digest"},
        "adapter_before_sha256": {"$ref": "#/$defs/digest"},
        "predicted_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "execution_receipt_claim_sha256": {
          "type": "null",
          "$comment": "An action commitment predates claimed physical execution; the source-only record cannot assert it."
        },
        "train_manifest_sha256": {"$ref": "#/$defs/digest"},
        "holdout_manifest_sha256": {"$ref": "#/$defs/digest"}
      },
      "$comment": "Manifest digest inequality is enforced by Python; semantic train/holdout exclusion requires a real host."
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_receipt_sha256", "evidence_id", "evaluator_id", "rubric_sha256",
        "outcome_evidence_sha256", "custody_claim_sha256", "measured_quality", "evidence_class"
      ],
      "properties": {
        "action_receipt_sha256": {"$ref": "#/$defs/digest"},
        "evidence_id": {"$ref": "#/$defs/digest"},
        "evaluator_id": {"$ref": "#/$defs/identifier"},
        "rubric_sha256": {"$ref": "#/$defs/digest"},
        "outcome_evidence_sha256": {"$ref": "#/$defs/digest"},
        "custody_claim_sha256": {"$ref": "#/$defs/nullableDigest"},
        "measured_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_class": {"const": "UNAUTHENTICATED_SOURCE_ONLY"}
      }
    },
    "optimizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_receipt_sha256", "outcome_receipt_sha256", "arm",
        "train_example_manifest_sha256", "holdout_exclusion_manifest_sha256",
        "declared_optimizer_steps", "gradient_summary_claim_sha256",
        "trainer_receipt_claim_sha256", "adapter_before_sha256", "adapter_after_sha256",
        "checkpoint_claim_sha256", "weight_change_evidence"
      ],
      "properties": {
        "action_receipt_sha256": {"$ref": "#/$defs/digest"},
        "outcome_receipt_sha256": {"$ref": "#/$defs/digest"},
        "arm": {"enum": ["frozen", "zero", "correct_outcome", "shuffled_outcome", "corrupt_outcome"]},
        "train_example_manifest_sha256": {"$ref": "#/$defs/digest"},
        "holdout_exclusion_manifest_sha256": {"$ref": "#/$defs/digest"},
        "declared_optimizer_steps": {"type": "integer", "minimum": 0},
        "gradient_summary_claim_sha256": {"$ref": "#/$defs/nullableDigest"},
        "trainer_receipt_claim_sha256": {"$ref": "#/$defs/nullableDigest"},
        "adapter_before_sha256": {"$ref": "#/$defs/digest"},
        "adapter_after_sha256": {"$ref": "#/$defs/digest"},
        "checkpoint_claim_sha256": {"$ref": "#/$defs/nullableDigest"},
        "weight_change_evidence": {"enum": ["DIGESTS_IDENTICAL", "DIGESTS_DIFFER_UNVERIFIED"]}
      },
      "allOf": [
        {
          "if": {"properties": {"arm": {"const": "frozen"}}},
          "then": {"properties": {
            "declared_optimizer_steps": {"const": 0},
            "weight_change_evidence": {"const": "DIGESTS_IDENTICAL"}
          }}
        },
        {
          "if": {"properties": {"arm": {"const": "zero"}}},
          "then": {"properties": {"weight_change_evidence": {"const": "DIGESTS_IDENTICAL"}}}
        },
        {
          "if": {"properties": {"declared_optimizer_steps": {"const": 0}}},
          "then": {"properties": {"weight_change_evidence": {"const": "DIGESTS_IDENTICAL"}}}
        }
      ],
      "$comment": "Python derives digest classification; source claims cannot assert actual optimizer or gradient custody."
    },
    "abort": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"reason": {"const": "TRAINER_FAILED"}}},
          "then": {"properties": {"restore_status": {"const": "HOST_RESTORE_UNVERIFIED"}}}
        }
      ],
      "required": [
        "action_receipt_sha256", "outcome_receipt_sha256", "reason",
        "restore_status", "restore_receipt_claim_sha256"
      ],
      "properties": {
        "action_receipt_sha256": {"$ref": "#/$defs/digest"},
        "outcome_receipt_sha256": {"$ref": "#/$defs/nullableDigest"},
        "reason": {
          "enum": [
            "ACTION_FAILED", "OUTCOME_MISSING", "OUTCOME_REJECTED", "POLICY_DENIED",
            "TRAINER_FAILED", "REPLAY_DETECTED", "WITHDRAWN"
          ]
        },
        "restore_status": {"enum": ["NO_OPTIMIZER_STARTED", "HOST_RESTORE_UNVERIFIED"]},
        "restore_receipt_claim_sha256": {"$ref": "#/$defs/nullableDigest"}
      }
    }
  }
}
